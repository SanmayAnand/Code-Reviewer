# ---- Pick ONE provider (all have a free tier / are free) ----
# gemini  -> free key from https://aistudio.google.com/apikey
# groq    -> free key from https://console.groq.com/keys
# ollama  -> fully local, no key, no limits (install from https://ollama.com)
# none    -> static analysis only (no AI, works offline)
LLM_PROVIDER=gemini
LLM_MODEL=gemini-flash-lite-latest
LLM_API_KEY=

# Optional overrides (model names change often - check the provider's docs)
# LLM_MODEL=gemini-flash-latest
# LLM_BASE_URL=
LLM_TIMEOUT_SECONDS=30

# Tunables from the SRS
LONG_METHOD_LINES=40
MAX_SNIPPET_LINES=2000
DAILY_REVIEW_LIMIT=20
